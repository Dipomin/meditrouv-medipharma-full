# Exemple de configuration locale (sans secret).
# Copier vers `.env` (non versionné) et ajuster si besoin.
# Seules les variables EXPO_PUBLIC_* sont injectées dans le bundle Expo.

EXPO_PUBLIC_API_URL="https://meditrouv.corlantechnology.com/api"

EXPO_PUBLIC_MEDICAMENTS_API_URL="https://meditrouv.corlantechnology.com/api/medicaments"
EXPO_PUBLIC_PHARMACIES_API_URL="https://meditrouv.corlantechnology.com/api/pharmacies"

EXPO_PUBLIC_CREATE_USERS_API_URL="https://meditrouv.corlantechnology.com/api/abonnement/users"
EXPO_PUBLIC_FETCH_USERS_API_URL="https://meditrouv.corlantechnology.com/api/abonnement/users/"
EXPO_PUBLIC_VERIF_API_URL="https://meditrouv.corlantechnology.com/api/abonnement/verif"
EXPO_PUBLIC_SEND_OTP_URL="https://meditrouv.corlantechnology.com/api/send-whatsapp"


